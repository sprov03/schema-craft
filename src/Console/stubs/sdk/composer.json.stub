{
    "name": "{{ packageName }}",
    "description": "API client SDK for {{ clientName }}",
    "version": "{{ version }}",
    "type": "library",
    "require": {
        "php": "^7.4|^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "{{ namespace }}\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
